# Local XAMPP database settings. Add a password here if your MySQL root account uses one.
DB_HOST=
DB_PORT=
DB_NAME=roadzyrf_roadline
DB_USER=
DB_PASSWORD=

# Application settings
APP_NAME=
APP_TIMEZONE=UTC

# Existing Roadline hazard source table and columns
ROADLINE_TABLE=
ROADLINE_ID_COLUMN=
ROADLINE_LABEL_COLUMN=

# Optional private upload directory. Leave empty to use the configured default outside the web root.
ROADLINE_UPLOAD_DIR=

# Optional one-time values for bin/create_super_admin.php. Keep blank unless needed.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
